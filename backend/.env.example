# TicketNest — backend configuration
#
# Copy to `.env` and fill in. Every value below is validated at startup by
# src/configs/env.ts: in production a missing or malformed value crashes the
# process, naming the variable. Development and test fall back to the defaults
# shown in brackets.
#
# Never commit the real .env — it is gitignored.

# ---------------------------------------------------------------- environment
# development | test | production
NODE_ENV=development
PORT=5000

# ----------------------------------------------------------------- datastore
# Must be a replica set for transactions (booking uses them). MongoDB Atlas is
# a replica set already; a local standalone mongod is NOT.
# [dev default: mongodb://127.0.0.1:27017/ticketnest]
MONGO_URI=

# ------------------------------------------------------------------- sessions
# Long random string. Also used as the CSRF secret. Rotating it signs everyone
# out. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ------------------------------------------------------------ browser origins
# Absolute origin of the frontend. Used to build the links in verification and
# password-reset emails — if this is wrong, those emails point at the wrong host.
# [dev default: http://localhost:5173]
FRONTEND_URL=

# Comma-separated origins allowed to make credentialed requests. FRONTEND_URL is
# added automatically. localhost origins are rejected in production.
# [dev default: http://localhost:5173,http://127.0.0.1:5173]
CORS_ORIGINS=

# ---------------------------------------------------------------------- email
# SendGrid API key, and the verified sender address it is allowed to send from.
SENDGRID_API_KEY=
FROM_EMAIL=

# Signing secrets for the email-verification and password-reset links. Use two
# different values, neither equal to SESSION_SECRET.
EMAIL_VERIFY_TOKEN_SECRET=
PASSWORD_RESET_TOKEN_SECRET=

# ------------------------------------------------------------------- payments
# Exposes POST /api/bookings/:id/mock-pay and /mock-fail, which mark a booking
# paid with no payment provider involved. Defaults to on outside production and
# OFF in production — the portfolio demo must set it explicitly.
ENABLE_MOCK_PAYMENTS=true

# --------------------------------------------------------------------- admins
# JSON array of addresses to seed as admins on boot. Accounts are created only
# if they do not already exist, and are flagged mustChangePassword.
# Remove both variables once the accounts exist.
# ADMIN_EMAILS=["admin@example.com"]
# ADMIN_INITIAL_PASSWORD=      # minimum 12 characters

# ------------------------------------------------------------------ uploads
# Cloudinary credentials for poster and venue image uploads.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
