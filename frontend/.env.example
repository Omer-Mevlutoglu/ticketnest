# TicketNest — frontend configuration
#
# Copy to `.env` and fill in. Vite only exposes variables prefixed with VITE_,
# and it inlines them into the built bundle — so everything here is PUBLIC.
# Never put a secret in this file.

# Origin used by the browser for API requests. No trailing slash.
# In local development, Vite proxies /api to the backend on port 5000 so
# session and CSRF cookies stay same-origin. Set the deployed API origin in
# Vercel for production builds.
VITE_API_BASE=http://localhost:5173
